
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unified_schema_v0_1.json",
  "title": "Unified Presentation Analysis Schema",
  "description": "Common structure for extracted PDF and PowerPoint presentation content.",
  "type": "object",
  "required": [
    "schema_version",
    "document",
    "units"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "document": {
      "type": "object",
      "required": [
        "document_id",
        "filename",
        "format",
        "number_of_units"
      ],
      "properties": {
        "document_id": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": ["pdf", "pptx"]
        },
        "number_of_units": {
          "type": "integer",
          "minimum": 0
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unit"
      }
    },
    "processing": {
      "type": "object",
      "properties": {
        "extraction_methods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cleaning_applied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ocr_applied": {
          "type": "boolean"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "statistics": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "required": [
        "unit_id",
        "unit_number",
        "unit_type",
        "elements"
      ],
      "properties": {
        "unit_id": {
          "type": "string"
        },
        "unit_number": {
          "type": "integer",
          "minimum": 1
        },
        "unit_type": {
          "type": "string",
          "enum": ["page", "slide"]
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          }
        },
        "notes": {
          "type": ["string", "null"]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "required": [
        "element_id",
        "order",
        "type",
        "source"
      ],
      "properties": {
        "element_id": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "image",
            "table",
            "chart",
            "diagram"
          ]
        },
        "subtype": {
          "type": ["string", "null"]
        },
        "text": {
          "type": ["string", "null"]
        },
        "content": {
          "type": [
            "object",
            "array",
            "string",
            "number",
            "null"
          ]
        },
        "classification": {
          "oneOf": [
            {
              "$ref": "#/$defs/classification"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "position": {
          "oneOf": [
            {
              "$ref": "#/$defs/position"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "$ref": "#/$defs/elementMetadata"
        }
      },
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "required": [
        "category",
        "method"
      ],
      "properties": {
        "category": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "enum": [
            "rule_based",
            "machine_learning",
            "manual"
          ]
        },
        "reason": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "extraction_method",
        "is_ocr"
      ],
      "properties": {
        "extraction_method": {
          "type": "string"
        },
        "is_ocr": {
          "type": "boolean"
        },
        "original_element_id": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "position": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height",
        "unit",
        "coordinate_system"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "point",
            "EMU",
            "pixel"
          ]
        },
        "coordinate_system": {
          "type": "string",
          "enum": [
            "page",
            "slide",
            "image"
          ]
        }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": [
        "relation_id",
        "type",
        "source_element_ids",
        "target_element_ids"
      ],
      "properties": {
        "relation_id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "source_element_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "target_element_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": ["string", "null"]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "elementMetadata": {
      "type": "object",
      "properties": {
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filename": {
          "type": ["string", "null"]
        },
        "content_type": {
          "type": ["string", "null"]
        },
        "width": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "height": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "size_bytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "shape_name": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
