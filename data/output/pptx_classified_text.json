        "content": [
            {
                "element_id": 1,
                "text": "Why Python?",
                "category": "title_candidate",
                "reason": "First text element of the slide"
            },
            {
                "element_id": 2,
                "text": "Stanford’s CS106A course adopted Python as its language of instruction about seven years ago.\nThe name of the language does not come from the snake that graces the cover of the O’Reilly book but rather is \na tribute to Monty Python’s Flying Circus.\nJavaScript dominates the browser side of web \nprogramming, while Python has become particularly important in scientific computing, data analysis, machine learning, and AI.\nPython is a general-purpose language with a huge collection of useful libraries, and many of those libraries perform demanding computations using highly optimized code written in C and C++.",
                "category": "paragraph_candidate",
                "reason": "Multiple complete explanatory sentences detected"
            }
        ]
