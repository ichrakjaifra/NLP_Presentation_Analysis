            {
                "element_id": 1,
                "text": "Standard HTML Document Pattern",
                "category": "title_candidate",
                "reason": "First text element of the slide"
            },
            {
                "element_id": 2,
                "text": "<!DOCTYPE html>\n<html>\n <head>\n  <title>title of the page</title>\n     One or more script tags to load JavaScript code.\n </head>\n <body onload=\"function()\">\n     Contents of the page, if any.\n </body>\n</html>",
                "category": "code_candidate",
                "reason": "Programming code structure detected"
            },
            {
                "element_id": 3,
                "text": "The following components of index.html are standardized:\nEvery file begins with a <!DOCTYPE html> declaration.\nThe entire document is enclosed in <html> and </html>.\nThe <head> section provides information about the page, including its title and any files it needs to load.\nThe <body> contains the content of the page.",
                "category": "paragraph_candidate",
                "reason": "Multiple complete explanatory sentences detected"
