            {
                "element_id": 1,
                "text": "Why Both JavaScript and Python",
                "category": "title_candidate",
                "reason": "First text element of the slide"
            },
            {
                "element_id": 2,
                "text": "Modern web pages depend on three related technologies: HTML (Hypertext Markup Language), CSS (Cascading Style Sheets), and JavaScript.\nThese tools are used to manage different parts of a web page:\nHTML is used to specify content, structure, and hierarchy.\nCSS is used to control appearance and formatting.\nJavaScript makes the page interactive and allows it to function like a desktop application running in a browser.\nMany major web properties—e.g., Gmail, Instagram, Dropbox, and Spotify—use Python extensively on the server.\nBy learning both languages, you’ll understand how web apps—both the client and server endpoints—are implemented.",
                "category": "paragraph_candidate",
                "reason": "Multiple complete explanatory sentences detected"
            }
